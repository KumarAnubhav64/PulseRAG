# --- Groq (optional — without a key the app runs in demo mode) ---
GROQ_API_KEY=your_groq_key_here
DEMO_MODE=auto            # auto | on | off

# --- Storage ---
REDIS_URL=redis://localhost:6379/0

# --- Embeddings (local, free, offline after first download) ---
EMBEDDING_BACKEND=sentence_transformers   # sentence_transformers | fastembed
EMBEDDING_MODEL=all-MiniLM-L6-v2

# --- RAG tuning ---
CHUNK_SIZE=500
CHUNK_OVERLAP=50
TOP_K=4
CACHE_TTL_SECONDS=3600

# --- Uploads ---
MAX_UPLOAD_MB=25
