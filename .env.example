# --- Groq (optional — without a key the app runs in demo mode) ---
GROQ_API_KEY=your_groq_key_here
DEMO_MODE=auto            # auto | on | off

# --- Storage ---
REDIS_URL=redis://localhost:6379/0

# --- Embeddings ---
# sentence_transformers (torch, ~760MB) | fastembed (ONNX, ~220MB) |
# remote (Mistral API, ~0MB — REQUIRED to fit Render free's 512MB)
EMBEDDING_BACKEND=sentence_transformers
# Local backends only — ~90MB, downloaded once on first use
EMBEDDING_MODEL=all-MiniLM-L6-v2
# Required when EMBEDDING_BACKEND=remote (free tier, no credit card)
MISTRAL_API_KEY=your_mistral_key_here
REMOTE_EMBEDDING_MODEL=mistral-embed

# --- RAG tuning ---
CHUNK_SIZE=500
CHUNK_OVERLAP=50
TOP_K=4
CACHE_TTL_SECONDS=3600

# --- Uploads ---
MAX_UPLOAD_MB=25
